# Виртуальное окружение: создаётся заново через requirements.txt
venv/
.venv/

# Датасет: тяжёлый, пользователь кладёт свой в images/
images/

# Индексы эмбеддингов: пересобираются командой search.py --rebuild
*.pkl

# Кэш переводов: создаётся автоматически при поиске
translations_cache.json

# Служебные файлы Python
__pycache__/
*.pyc

# Секреты и локальные настройки: никогда не публиковать
.env
